# ==========================================
# Server Configuration (.env)
# ==========================================
PORT=5000

# LLM Providers (Supports comma-separated keys for automatic rotation e.g. key1,key2)
GEMINI_API_KEYS=your_gemini_api_key_here
GROQ_API_KEYS=your_groq_api_key_here
OPENROUTER_API_KEYS=your_openrouter_api_key_here

SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------
# Google OAuth 2.0 (Authorization Code Flow)
# Create credentials at:
#   https://console.cloud.google.com → APIs & Services → Credentials
#   Application type: Web application
# ------------------------------------------
# OAuth 2.0 Client ID (from Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# OAuth 2.0 Client Secret (from Google Cloud Console → Credentials)
# NEVER commit a real value — keep in server/.env only
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Redirect URI — must be registered EXACTLY in Google Cloud Console
# Authorized redirect URIs to add:
#   Local dev : http://localhost:5000/api/auth/google/callback
#   Production: https://mediflow-ai-kappa.vercel.app/api/auth/google/callback
# Note: Vercel preview deployments are NOT supported (Google disallows wildcards).
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Calendar Integration (separate from OAuth login — defaults to Mock Mode)
ENABLE_REAL_GOOGLE_CALENDAR=false

# ------------------------------------------
# JWT Session (Stateless — required for Vercel serverless)
# ------------------------------------------
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value in production (Vercel env var) vs local dev.
JWT_SECRET=your_random_256_bit_hex_secret_here

# JWT lifetime — uses jsonwebtoken duration strings (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# ==========================================
# Client Configuration (client/.env)
# ==========================================
VITE_API_URL=http://localhost:5000
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
